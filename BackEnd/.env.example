# ============================================================
#  Le Fil d'Or — BackEnd settings
#  This is the ONLY file you edit when you deploy.
#  After changing it, restart the Django server.
# ============================================================

# ---------- Database (PostgreSQL) ----------
DB_NAME=le_fil_dor
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5433

# ---------- Django ----------
# In production: DEBUG=False and a long random SECRET_KEY
# (generate one with:  python -c "import secrets; print(secrets.token_urlsafe(60))")
DEBUG=True
SECRET_KEY=

# Domains allowed to reach the API, separated by commas (no https://)
ALLOWED_HOSTS=localhost,127.0.0.1

# Addresses of the website (FrontEnd) allowed to call this API, separated by commas
# Production example: https://lefildor.dz,https://www.lefildor.dz
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Public address of the website. Used for the "open dashboard" button inside the order email.
FRONTEND_URL=http://localhost:5173

# ---------- First admin account ----------
# Created by:  python manage.py create_admin
# (the admin can change the email and password later from the dashboard settings page)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@lefildor.dz
ADMIN_PASSWORD=

# ---------- Email notifications (free Gmail) ----------
# 1) Gmail account -> Security -> turn on 2-Step Verification
# 2) Security -> App passwords -> create one -> you get 16 letters (spaces are ignored)
# While EMAIL_HOST_USER / EMAIL_HOST_PASSWORD are empty, emails are only PRINTED in the terminal.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Who receives the new-order email. Leave empty to use EMAIL_HOST_USER.
ORDER_NOTIFY_EMAIL=

# ---------- Uploads & login ----------
MAX_UPLOAD_MB=10
# How many days the admin stays logged in
TOKEN_LIFETIME_DAYS=7

# Behind nginx / a proxy: set to 1 so the rate limits see the real visitor IP
# NUM_PROXIES=1
